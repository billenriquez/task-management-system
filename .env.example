# PostgreSQL connection strings. Use provider-specific pooled and direct URLs if applicable.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Generate a long random value; do not reuse it between environments.
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required for registration verification, password reset, and two-factor email.
BREVO_API_KEY="replace-with-your-brevo-api-key"
BREVO_SENDER_EMAIL="your-verified-sender@gmail.com"
BREVO_SENDER_NAME="TaskMate"
